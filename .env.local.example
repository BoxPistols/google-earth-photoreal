# Cesium ion access token — required for Photorealistic 3D Tiles via Cesium ion.
# Get yours at https://ion.cesium.com/tokens (you said you already have one).
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Optional: if you prefer to use Google Maps Platform's Map Tiles API directly
# (without going through Cesium ion), put your Google API key here. Phase 1 uses
# Cesium ion's Google Photorealistic 3D Tiles asset by default.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
